{
  "name": "synctable-desktop",
  "version": "0.1.0",
  "description": "Cross-browser tree backup and workspace synchronization utility (Desktop App)",
  "type": "module",
  "scripts": {
    "build:native": "./scripts/build-dia-db-reader.sh",
    "build:css": "tailwindcss -i ./src/mainview/tailwind.css -o ./src/mainview/style.css --minify",
    "predev": "bun run build:native && bun run build:css",
    "dev": "electrobun dev",
    "prebuild": "bun run build:native && bun run build:css",
    "build": "electrobun build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@synctable/ui": "*",
    "@types/lz4js": "^0.2.2",
    "clsx": "^2.1.1",
    "electrobun": "^1.18.1",
    "lucide-react": "^0.400.0",
    "lz4js": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}

{
  "name": "synctable-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd ./apps/synctable-web dev",
    "dev:web": "bun run --cwd ./apps/synctable-web dev",
    "dev:desktop": "bun run --cwd ./apps/synctable-desktop dev",
    "dev:desktop:admin": "powershell -Command \"Start-Process powershell -ArgumentList '-NoExit', '-Command', 'Set-Location (Get-Location); bun dev:desktop' -Verb RunAs\"",
    "build": "bun run --cwd ./apps/synctable-web build",
    "build:web": "bun run --cwd ./apps/synctable-web build",
    "build:desktop": "bun run --cwd ./apps/synctable-desktop build",
    "package": "bun run --cwd ./apps/synctable-desktop package",
    "package:desktop": "bun run --cwd ./apps/synctable-desktop package",
    "package:mac": "bun run --cwd ./apps/synctable-desktop package:mac",
    "package:win": "bun run --cwd ./apps/synctable-desktop package:win",
    "start": "bun run --cwd ./apps/synctable-web start",
    "start:web": "bun run --cwd ./apps/synctable-web start",
    "start:desktop": "bun run --cwd ./apps/synctable-desktop start",
    "test": "bun test",
    "version:bump": "bun run ./scripts/bump-version.ts",
    "lint": "bun run --cwd ./apps/synctable-web lint",
    "typecheck": "bun run --cwd ./apps/synctable-web typecheck"
  }
}

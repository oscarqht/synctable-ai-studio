{
  "name": "synctable-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=synctable-web",
    "dev:web": "npm run dev --workspace=synctable-web",
    "dev:desktop": "npm run dev --workspace=synctable-desktop",
    "dev:desktop:admin": "powershell -Command \"Start-Process powershell -ArgumentList '-NoExit', '-Command', 'Set-Location (Get-Location); bun dev:desktop' -Verb RunAs\"",
    "build": "npm run build --workspace=synctable-web",
    "build:web": "npm run build --workspace=synctable-web",
    "build:desktop": "npm run build --workspace=synctable-desktop",
    "package": "npm run package --workspace=synctable-desktop",
    "package:desktop": "npm run package --workspace=synctable-desktop",
    "start": "npm run start --workspace=synctable-web",
    "start:web": "npm run start --workspace=synctable-web",
    "start:desktop": "npm run start --workspace=synctable-desktop",
    "test": "bun test",
    "lint": "npm run lint --workspace=synctable-web",
    "typecheck": "npm run typecheck --workspace=synctable-web"
  }
}

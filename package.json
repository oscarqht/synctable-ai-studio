{
  "name": "synctable-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.1.30",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],

  "scripts": {
    "dev:desktop": "bun --filter synctable-desktop dev",
    "dev:web": "bun --filter synctable-web dev",
    "build:desktop": "bun --filter synctable-desktop build",
    "build:web": "bun --filter synctable-web build",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck"
  }
}
